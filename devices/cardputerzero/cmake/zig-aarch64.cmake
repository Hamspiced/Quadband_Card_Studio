set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT EXISTS "${QB_ZIG_EXECUTABLE}")
    message(FATAL_ERROR "Set QB_ZIG_EXECUTABLE to an existing Zig compiler")
endif()
set(CMAKE_C_COMPILER "${QB_ZIG_EXECUTABLE}")
set(CMAKE_C_COMPILER_ARG1 cc)
set(CMAKE_CXX_COMPILER "${QB_ZIG_EXECUTABLE}")
set(CMAKE_CXX_COMPILER_ARG1 c++)
set(CMAKE_ASM_COMPILER "${QB_ZIG_EXECUTABLE}")
set(CMAKE_ASM_COMPILER_ARG1 cc)
set(CMAKE_AR "${QB_ZIG_EXECUTABLE}" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "${QB_ZIG_EXECUTABLE}" CACHE FILEPATH "" FORCE)
set(CMAKE_C_ARCHIVE_CREATE "\"${QB_ZIG_EXECUTABLE}\" ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_C_ARCHIVE_APPEND "\"${QB_ZIG_EXECUTABLE}\" ar q <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_C_ARCHIVE_FINISH "\"${QB_ZIG_EXECUTABLE}\" ranlib <TARGET>")
set(CMAKE_CXX_ARCHIVE_CREATE "${CMAKE_C_ARCHIVE_CREATE}")
set(CMAKE_CXX_ARCHIVE_APPEND "${CMAKE_C_ARCHIVE_APPEND}")
set(CMAKE_CXX_ARCHIVE_FINISH "${CMAKE_C_ARCHIVE_FINISH}")
set(CMAKE_C_FLAGS_INIT "-target aarch64-linux-musl")
set(CMAKE_CXX_FLAGS_INIT "-target aarch64-linux-musl")
set(CMAKE_ASM_FLAGS_INIT "-target aarch64-linux-musl")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES QB_ZIG_EXECUTABLE)
